{
  "watch": ["server"],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    ".git",
    "server/data/**",
    "public/temp/**",
    "public/cache/**",
    "uploads/**",
    "extracted_assets/**",
    "dist/**",
    "**/*.temp/**",
    "**/*.html",
    "**/*.htm",
    "**/*.zip",
    "*.test.js"
  ],
  "exec": "node --max-old-space-size=8192 server/server.js"
}
