{
  "manifest_version": 3,
  "name": "Auto Browser Automation Bridge",
  "version": "1.1.0",
  "description": "Bypasses local servers to control the Oman Tender Board portal directly.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "favicon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3001/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5174/*",
        "https://*.tenderboard.gov.om/*",
        "https://*.vercel.app/*",
        "https://boqv2.vercel.app/*",
        "https://boq-v2.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3001/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5174/*",
    "https://*.tenderboard.gov.om/*",
    "https://*.vercel.app/*",
    "https://boqv2.vercel.app/*",
    "https://boq-v2.vercel.app/*",
    "https://lens.google.com/*",
    "https://*.google.com/*"
  ]
}
